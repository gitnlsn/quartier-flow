// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  // Neon: pooled URL for the app, direct URL for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth). Generated with `npx auth@1.7.20 generate`,
// then merged here. Regenerate after adding Better Auth plugins.
// IDs: Better Auth generates its own; @default(cuid()) covers rows created by
// scripts or app code through Prisma.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  // Brazilian CPF (digits only). Required by Asaas for whoever pays a unit's charges.
  cpf                 String?
  administradoraRoles AdministradoraMember[]
  memberships         Membership[]
  paymentCustomer     PaymentCustomer?
  agreementsCreated   Agreement[]            @relation("AgreementCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String
  message   String?
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Tenancy: Administradora -> Condominium -> Unit (docs/features/02, 19)
// ---------------------------------------------------------------------------

model Administradora {
  id              String    @id @default(cuid())
  name            String
  cnpj            String    @unique // digits only
  companyType     String? // Asaas: LIMITED | ASSOCIATION | MEI | INDIVIDUAL
  email           String
  mobilePhone     String?
  incomeValue     Int? // monthly revenue in BRL, required by Asaas KYC
  postalCode      String?
  address         String?
  addressNumber   String?
  complement      String?
  province        String? // bairro
  status          String    @default("onboarding") // onboarding | active | closed
  /// Asaas customer on our main account, billed for the platform (docs/features/18)
  asaasCustomerId String?   @unique
  /// Closed by its admin: no management, no new invoices (docs/features/19)
  closedAt        DateTime?
  closedById      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members          AdministradoraMember[]
  condominiums     Condominium[]
  plans            AdministradoraPlan[]
  payoutAccount    PayoutAccount?
  platformInvoices PlatformInvoice[]
}

model AdministradoraMember {
  id               String         @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String         @default("admin")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([administradoraId, userId])
  @@index([userId])
}

model Condominium {
  id                  String         @id @default(cuid())
  administradoraId    String
  administradora      Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  name                String
  cnpj                String?
  address             String?
  /// Common area reservations module switched on (docs/features/06)
  reservationsEnabled Boolean        @default(false)
  /// Cash on hand before Quartier Flow, the starting point of the balance (docs/features/05)
  openingBalanceCents Int            @default(0)
  openingBalanceDate  DateTime?      @db.Date
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  units         Unit[]
  memberships   Membership[]
  billingConfig BillingConfig?
  billingRuns   BillingRun[]
  charges       Charge[]
  billingItems  BillingItem[]
  unitItems     UnitBillingItem[]
  expenses      Expense[]
  commonAreas   CommonArea[]
  reservations  Reservation[]
  areaBlocks    AreaBlock[]
  agreements    Agreement[]
  balanceSheets BalanceSheet[]

  @@index([administradoraId])
}

model Unit {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  block         String      @default("") // "" when the building has no blocks
  number        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberships   Membership[]
  charges       Charge[]
  itemOverrides BillingItemOverride[]
  items         UnitBillingItem[]
  reservations  Reservation[]
  agreements    Agreement[]

  @@unique([condominiumId, block, number])
  @@index([condominiumId])
}

model Membership {
  id                     String      @id @default(cuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  condominiumId          String
  condominium            Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  unitId                 String?
  unit                   Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  role                   String // resident | sindico
  residentType           String? // owner | tenant | dependent
  financiallyResponsible Boolean     @default(false)
  endedAt                DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([condominiumId])
  @@index([unitId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Platform plans (docs/features/18). Prices are placeholders until defined.
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  description       String
  residentSeatCents Int
  sindicoSeatCents  Int
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions AdministradoraPlan[]
}

model AdministradoraPlan {
  id               String         @id @default(cuid())
  administradoraId String
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan           @relation(fields: [planId], references: [id])
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([administradoraId])
}

/// Monthly Quartier Flow invoice to an administradora (docs/features/18):
/// seats active at the end of the billed range, prorated by days, charged
/// from our main Asaas account. A snapshot: never recomputed after issuing.
model PlatformInvoice {
  id                String         @id @default(cuid())
  administradoraId  String
  administradora    Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  period            String // YYYY-MM billed
  periodStart       DateTime // first billed day
  periodEnd         DateTime // last billed day
  planId            String
  planName          String
  residentSeats     Int
  sindicoSeats      Int
  residentSeatCents Int
  sindicoSeatCents  Int
  billedDays        Int
  daysInMonth       Int
  totalCents        Int
  dueDate           DateTime
  status            String         @default("pending") // pending | paid | overdue | canceled | failed | waived
  issue             String?
  asaasPaymentId    String?        @unique
  invoiceUrl        String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([administradoraId, period])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Payments via Asaas (docs/features/03, 17)
// ---------------------------------------------------------------------------

model PayoutAccount {
  id               String         @id @default(cuid())
  administradoraId String         @unique
  administradora   Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)
  asaasAccountId   String         @unique
  walletId         String
  apiKeyEncrypted  String? // subaccount key (returned once), AES-GCM via src/server/crypto.ts
  kycStatus        String         @default("pending") // pending | awaiting_approval | approved | rejected
  onboardingUrl    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PaymentCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asaasCustomerId  String   @unique
  /// Reminder settings last applied to this customer's Asaas notifications
  /// (docs/features/04), so they are only re-synced when they change.
  notificationsKey String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BillingConfig {
  id               String      @id @default(cuid())
  condominiumId    String      @unique
  condominium      Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  enabled          Boolean     @default(false)
  mode             String      @default("manual") // manual | automatic
  dueDay           Int         @default(10) // 1-28
  generationDay    Int         @default(1) // 1-28, day the run is prepared (and sent if automatic)
  finePercent      Decimal     @default(2) @db.Decimal(5, 2)
  interestPercent  Decimal     @default(1) @db.Decimal(5, 2) // per month
  /// Payment reminders sent by Asaas (docs/features/04). 0 = Asaas's fixed
  /// slot (on the due date / when overdue) + at most one adjustable value.
  reminderBefore   Int[]       @default([0, 10]) // 0 and/or one of 5 | 10 | 15 | 30 days before
  reminderAfter    Int[]       @default([0, 7]) // 0 and/or one of 1 | 7 | 15 | 30 days after
  reminderEmail    Boolean     @default(true)
  reminderSms      Boolean     @default(true)
  reminderWhatsapp Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model BillingRun {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  period        String // YYYY-MM
  mode          String // manual | automatic (mode at preparation time)
  status        String      @default("draft") // draft | sending | sent | partially_failed
  dueDate       DateTime
  approvedById  String? // null when sent automatically
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  charges Charge[]

  @@unique([condominiumId, period])
}

model Charge {
  id              String       @id @default(cuid())
  condominiumId   String
  condominium     Condominium  @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  runId           String?
  run             BillingRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  payerUserId     String?
  type            String // monthly | extra | reservation | fine | agreement
  description     String
  amountCents     Int
  dueDate         DateTime
  // draft | skipped | pending | confirmed | received | overdue | canceled | refunded | failed
  // | renegotiated (replaced by an acordo, deleted on Asaas: docs/features/04)
  // | forgiven (written off by the administradora, deleted on Asaas: 04)
  status          String       @default("draft")
  issue           String? // why a draft can't be sent (no payer, missing CPF...) or Asaas error
  asaasPaymentId  String?      @unique
  invoiceUrl      String?
  bankSlipUrl     String?
  paidAt          DateTime?
  paidAmountCents Int?
  feeCents        Int? // Asaas fee (value - netValue), paid by the administradora
  lines           ChargeLine[]
  /// Written off by the administradora (docs/features/04): who, when, why
  forgivenAt      DateTime?
  forgivenById    String?
  forgivenReason  String?
  /// Acordo that renegotiated this charge (docs/features/04)
  agreementId     String?
  agreement       Agreement?   @relation("AgreementOriginalCharges", fields: [agreementId], references: [id], onDelete: SetNull)
  /// Set on the acordo's entrada (down payment) charge
  downPaymentOf   Agreement?   @relation("AgreementDownPayment")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([runId, unitId])
  @@index([condominiumId, status])
  @@index([unitId])
  @@index([agreementId])
}

/**
 * Acordo (docs/features/04): replaces a unit's overdue charges, which are
 * deleted on Asaas (status `renegotiated`). The installments are a
 * UnitBillingItem that rides on the next monthly charges; the optional
 * entrada is a standalone charge issued right away.
 * status: pending (Asaas deletions not finished) | active | broken.
 * "Em atraso" and "concluído" are derived from the charges on read.
 */
model Agreement {
  id                  String           @id @default(cuid())
  condominiumId       String
  condominium         Condominium      @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  unitId              String
  unit                Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  payerUserId         String?
  status              String           @default("pending")
  originalCents       Int // sum of the renegotiated charges (without fine/interest)
  totalCents          Int // entrada + installments * installmentCents
  downPaymentCents    Int              @default(0)
  downPaymentDueDate  DateTime?
  installments        Int
  installmentCents    Int
  billingItemId       String?          @unique
  billingItem         UnitBillingItem? @relation(fields: [billingItemId], references: [id], onDelete: SetNull)
  downPaymentChargeId String?          @unique
  downPaymentCharge   Charge?          @relation("AgreementDownPayment", fields: [downPaymentChargeId], references: [id], onDelete: SetNull)
  notes               String?
  createdById         String
  createdBy           User             @relation("AgreementCreatedBy", fields: [createdById], references: [id])
  brokenAt            DateTime?
  brokenById          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  originalCharges Charge[] @relation("AgreementOriginalCharges")

  @@index([condominiumId])
  @@index([unitId])
}

model WebhookEvent {
  id          String    @id // Asaas evt_... id
  event       String
  payload     Json
  status      String    @default("received") // received | processed | error
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

/**
 * Legal record of a Termos de Uso acceptance (docs/features/19). Append-only and
 * without foreign keys, like AuditLog: deleting a user or administradora must
 * not erase the evidence of what was accepted, when and from where.
 */
model TermsAcceptance {
  id               String   @id @default(cuid())
  userId           String
  administradoraId String?
  planId           String? // plan signed together with the terms
  termsVersion     String // src/lib/terms.ts TERMS_VERSION
  ipAddress        String?
  userAgent        String?
  acceptedAt       DateTime @default(now())

  @@index([userId])
  @@index([administradoraId])
}

model AuditLog {
  id               String   @id @default(cuid())
  administradoraId String?
  actorUserId      String? // null = system (cron, webhook)
  action           String
  entity           String
  entityId         String
  data             Json?
  createdAt        DateTime @default(now())

  @@index([administradoraId, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Billing items (docs/features/03): what each unit pays, line by line.
// Recurrence: "monthly" from startPeriod; "installments" for `installments`
// months from startPeriod; "once" only in startPeriod. Periods are YYYY-MM.
// ---------------------------------------------------------------------------

/**
 * Item every unit of the condominium pays (e.g. Taxa condominial).
 */
model BillingItem {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  amountCents   Int
  recurrence    String // monthly | installments | once
  startPeriod   String
  installments  Int?
  archivedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  overrides BillingItemOverride[]

  @@index([condominiumId])
}

/**
 * Different amount of a shared item for one unit (e.g. penthouse).
 */
model BillingItemOverride {
  id          String      @id @default(cuid())
  itemId      String
  item        BillingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([itemId, unitId])
  @@index([unitId])
}

/**
 * Item only one unit pays (e.g. gas consumption, extra parking spot, fine).
 */
model UnitBillingItem {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  amountCents   Int
  recurrence    String // monthly | installments | once
  startPeriod   String
  installments  Int?
  source        String      @default("manual") // manual | import | reservation | agreement
  archivedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reservation Reservation?
  agreement   Agreement?

  @@index([unitId])
  @@index([condominiumId, startPeriod])
}

/**
 * Snapshot of the items of a charge: later item edits don't change it.
 */
model ChargeLine {
  id          String   @id @default(cuid())
  chargeId    String
  charge      Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  kind        String // shared | individual
  sourceId    String? // BillingItem.id or UnitBillingItem.id
  name        String
  description String?
  installment String? // "2/6"
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([chargeId])
}

// ---------------------------------------------------------------------------
// Financial transparency (docs/features/05)
// ---------------------------------------------------------------------------

/**
 * An expense paid by the condominium, optionally with its invoice/receipt.
 * The file lives in the private "attachments" bucket (Neon Object Storage);
 * we store its key and serve it through short-lived signed URLs.
 */
model Expense {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  category      String
  supplier      String?
  description   String
  amountCents   Int
  paidAt        DateTime    @db.Date
  createdById   String?

  attachmentKey  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([condominiumId, paidAt])
}

/**
 * Monthly balancete (docs/features/05). While a draft it is computed live from
 * charges and expenses; publishing freezes the numbers in `snapshot`
 * (BalanceSheetData, src/lib/finance.ts), which is all residents ever see.
 * Expenses of a published month are locked until it is unpublished.
 */
model BalanceSheet {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  period        String
  /// draft | published
  status        String      @default("draft")
  snapshot      Json?
  notes         String?
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([condominiumId, period])
  @@index([condominiumId, status])
}

// ---------------------------------------------------------------------------
// Common area reservations (docs/features/06)
// Times are stored in UTC and shown in America/Sao_Paulo (src/lib/reservations.ts).
// ---------------------------------------------------------------------------

/**
 * A bookable space (party room, barbecue area, court) and the rules the
 * síndico sets once; src/server/reservations.ts enforces them.
 */
model CommonArea {
  id                 String      @id @default(cuid())
  condominiumId      String
  condominium        Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  name               String
  description        String? // rules text shown to residents
  capacity           Int?
  feeCents           Int         @default(0) // added to the unit's next monthly charge
  slotType           String      @default("day") // day | hour
  opensHour          Int         @default(8) // hourly areas: first bookable hour (0-23)
  closesHour         Int         @default(22) // hourly areas: closing hour (1-24)
  maxHours           Int? // hourly areas: longest booking
  requiresApproval   Boolean     @default(false)
  minAdvanceHours    Int         @default(24)
  maxAdvanceDays     Int         @default(90)
  maxPerUnitPerMonth Int?
  cancelUntilHours   Int         @default(48) // residents cancel up to N hours before
  blockDelinquent    Boolean     @default(true) // units with overdue charges can't book
  closedWeekdays     Int[] // recurring closure: 0 = Sunday … 6 = Saturday
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  reservations Reservation[]
  blocks       AreaBlock[]

  @@index([condominiumId])
}

/**
 * One-off closure (maintenance, a condominium event) of one area or, with no
 * area, all of them. Created from the Reservas page; past blocks simply stop
 * mattering, so nobody has to clean them up.
 */
model AreaBlock {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  areaId        String? // null = every area of the condominium
  area          CommonArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)
  startsOn      String // YYYY-MM-DD (São Paulo), inclusive
  endsOn        String // YYYY-MM-DD (São Paulo), inclusive
  reason        String?
  createdById   String?
  createdAt     DateTime    @default(now())

  @@index([condominiumId, endsOn])
}

/**
 * A booking of an area by a unit. Pending and confirmed bookings hold the
 * slot; rejected and canceled ones free it. A past confirmed booking is shown
 * as "Realizada" (no stored status change).
 */
model Reservation {
  id            String           @id @default(cuid())
  condominiumId String
  condominium   Condominium      @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  areaId        String
  area          CommonArea       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  requestedById String?
  startsAt      DateTime
  endsAt        DateTime
  status        String           @default("pending") // pending | confirmed | rejected | canceled
  guestNames    String[]
  notes         String?
  feeCents      Int              @default(0) // area fee when booked (snapshot)
  /// One-off item on the unit's monthly charge with the fee
  billingItemId String?          @unique
  billingItem   UnitBillingItem? @relation(fields: [billingItemId], references: [id], onDelete: SetNull)
  decidedById   String? // approved, rejected or canceled by
  decidedAt     DateTime?
  decisionNote  String? // reason for rejecting or canceling
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([areaId, startsAt])
  @@index([condominiumId, startsAt])
  @@index([unitId])
}
